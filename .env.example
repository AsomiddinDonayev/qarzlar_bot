# Bot + Server
TELEGRAM_BOT_TOKEN=your_bot_token_here
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here   # Settings → API → JWT Secret
WEBAPP_URL=https://your-mini-app.vercel.app

# CORS (comma-separated origins for the auth server)
ALLOWED_ORIGINS=https://your-mini-app.vercel.app

# Optional
CRON_SCHEDULE=0 9 * * *
CRON_TZ=Asia/Tashkent
DEFER_DAYS=3
PORT=3001
